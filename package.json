{
  "name": "nexa-messenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "postinstall": "npx prisma generate",
    "dev": "tsx server.ts",
    "prebuild": "node scripts/write-runtime-config.cjs",
    "build": "npm run lint && npx prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','server.js']) fs.rmSync(p,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "tsx --test tests/**/*.test.ts",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "desktop": "npx electron .",
    "desktop:build": "npx electron-builder",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.1",
    "@prisma/client": "^6.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.13.25",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.7.0",
    "idb": "^8.0.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.1.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-adapter": "^2.5.7",
    "socket.io-client": "^4.8.3",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "vite": "^6.2.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pino": "^7.0.4",
    "@types/pino-http": "^5.8.4",
    "autoprefixer": "^10.4.21",
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.nexa.messenger",
    "productName": "Nexa Messenger",
    "copyright": "Copyright © 2026 Nexa",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/nexa-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexa Messenger"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.js",
      "build/nexa-logo.ico",
      "node_modules/.prisma/client/**/*",
      "prisma/dev.db",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client"
      },
      {
        "from": "node_modules/.prisma/client",
        "to": "node_modules/.prisma/client"
      }
    ],
    "asar": true
  }
}
